{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API — Hono + Drizzle + PostgreSQL",
  "main": "src/index.ts",
  "types": "src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "echo 'The API runs straight from TypeScript through tsx; see docs/features/docker.md for packaging' && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed/index.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@app/contract": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.9.0",
    "@node-rs/argon2": "^2.0.0",
    "bullmq": "^6.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.1.0",
    "tsx": "^4.20.0",
    "vitest": "^4.1.0"
  }
}
