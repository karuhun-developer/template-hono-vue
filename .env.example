# === Application ===
NODE_ENV=development
APP_NAME=App
API_URL=http://localhost:7300

# === Ports ===
# Deliberately unusual so they do not collide with whatever else runs on this machine.
# `apps/*/vite.config.ts` uses strictPort, so a busy port fails loudly instead of
# silently moving — a moved port would no longer match CORS_ORIGINS below.
API_PORT=7300
CONSOLE_PORT=7301
POSTGRES_PORT=7332

# === CORS ===
# Comma-separated list of browser origins allowed to send credentialed requests.
# Adding a frontend app means adding its origin here — and nothing else.
# `*` is rejected at boot in production: a wildcard with credentials is refused by
# browsers anyway, and failing at startup beats debugging a preflight.
CORS_ORIGINS=http://localhost:7301

# === Database (Postgres 17 container on port 7332) ===
POSTGRES_HOST=localhost
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgres://app:app@localhost:7332/app

# === Session ===
SESSION_COOKIE_NAME=app_session
SESSION_TTL_DAYS=30
# How long a password reset link stays usable, in minutes (5–1440). An invitation lives for
# days because it has to survive a weekend; a reset only has to survive the walk to an inbox.
PASSWORD_RESET_TTL_MINUTES=60

# === Queue ===
# sync|database|redis. `database` makes Postgres the queue, which is the only way an enqueue
# can commit together with the change that caused it. `sync` runs handlers inline, in the
# caller's process — the test suite uses it, and it lists nothing on the Jobs page. `redis`
# is BullMQ, and needs REDIS_URL below.
QUEUE_DRIVER=database
# How long the poller waits after finding nothing. It does not wait when it found something.
QUEUE_POLL_MS=1000
# Jobs claimed per batch by one worker.
QUEUE_CONCURRENCY=5
# Attempts before a job lands `failed` and stays there for somebody to look at.
QUEUE_MAX_ATTEMPTS=3
# A job still `running` after this long is assumed to belong to a worker that died, and is
# handed back. A live worker finishes or fails in seconds.
QUEUE_STALE_AFTER_MINUTES=15
# How long a shutting-down worker waits for the jobs still running before telling them,
# through ctx.signal, that nobody is waiting any more. Below the shutdown registry's own
# 10-second patience, so the warning it logs is one somebody actually sees.
QUEUE_SHUTDOWN_GRACE_MS=8000
# Run the worker inside the API process. Unset, it is on in development — `make dev` stays
# one terminal — and off everywhere else, so production runs `make worker` alongside the API
# and can restart or scale the two independently.
# WORKER_IN_PROCESS=false

# === Mail ===
# log|smtp. `log` is the default and a real driver: the message is written to the log and to
# the mail_messages table, so a fresh clone with no SMTP server anywhere can still invite
# somebody and read the link. It is allowed in production and warns at boot when it is.
MAIL_DRIVER=log
# The envelope sender, copied onto every message as it read at the time.
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=App
# How long a sent or failed message is kept before `mail.prune` deletes it.
MAIL_RETENTION_DAYS=30
# Where the console is, from the outside. Every link in an email is absolute and built from
# this — the code that builds it runs in a worker, where there is no window.location. Its
# origin must appear in CORS_ORIGINS, or the page the link opens cannot call this API; the
# API refuses to boot otherwise.
CONSOLE_URL=http://localhost:7301

# === SMTP ===
# Only read when MAIL_DRIVER=smtp, and required as soon as it is: the API refuses to boot
# without a host rather than letting every invitation retry three times and land failed.
# `make up-mail` runs Mailpit, which accepts everything and delivers nothing — point the two
# settings below at it and read the result on http://localhost:8025.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Implicit TLS. Unset, it is inferred from the port: 465 yes, anything else no — on 587 the
# connection still upgrades through STARTTLS. Set it only for a relay that put SMTPS
# somewhere unusual.
# SMTP_SECURE=false
# Both optional. Leave them unset for a relay that authenticates by IP; no credentials are
# offered at all then, rather than an empty pair it would refuse. Never commit a real one.
# SMTP_USER=
# SMTP_PASSWORD=

# === Redis ===
# Only read by the subsystems pointed at it, and required as soon as one is: the API refuses
# to boot with QUEUE_DRIVER=redis and no URL. `make up-redis` publishes it on 7379.
# REDIS_URL=redis://localhost:7379

# === Logging ===
# trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info
# Pretty-print through pino-pretty. Turn this off in production — JSON is what log
# aggregators actually want.
LOG_PRETTY=true

# === Seed ===
# The first account `make seed` creates. Change these before seeding anything real.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_NAME=Owner
SEED_OWNER_PASSWORD=password123

# === Frontend ===
# Only VITE_-prefixed variables are bundled into the browser — never put a secret here.
VITE_API_URL=http://localhost:7300
